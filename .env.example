# Environment Variables - WhatsApp Engine com Evolution API v2
# Copie este arquivo para .env e preencha com seus valores

# ===========================================
# CONFIGURAÇÕES DO SERVIDOR
# ===========================================
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# CORS Origins (separados por vírgula)
CORS_ORIGINS=https://www.treexonline.online,https://treexonline.online,http://localhost:3000

# Limites do body parser
BODY_LIMIT=10mb

# ===========================================
# EVOLUTION API v2
# ===========================================
# URL da Evolution API
EVOLUTION_API_URL=https://api.evolution-api.com

# Sua API Key da Evolution
EVOLUTION_API_KEY=sua_api_key_aqui

# Timeout das requisições (ms)
EVOLUTION_TIMEOUT=30000

# Tentativas de retry
EVOLUTION_RETRY_ATTEMPTS=3

# ===========================================
# WEBHOOK CONFIG
# ===========================================
# URL pública para receber webhooks da Evolution
# IMPORTANTE: Deve ser acessível via internet
WEBHOOK_URL=https://seu-backend.railway.app/api/webhooks/evolution

# Segredo do webhook (opcional)
# WEBHOOK_SECRET=seu_webhook_secret

# ===========================================
# SUPABASE CONFIG
# ===========================================
# URL do seu projeto Supabase
SUPABASE_URL=https://your-project.supabase.co

# Service Role Key (NUNCA expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_aqui

# Anon Key (pode ser usada no frontend)
SUPABASE_ANON_KEY=your_anon_key_aqui

# ===========================================
# WHATSAPP CONFIG
# ===========================================
# Delay para resposta automática (ms)
AUTO_REPLY_DELAY=2000

# Cooldown padrão entre respostas (horas)
DEFAULT_COOLDOWN_HOURS=1

# Tamanho máximo da mensagem
MAX_MESSAGE_LENGTH=4096

# Tempo de expiração do QR (ms)
QR_EXPIRATION_TIME=60000

# ===========================================
# LOGGING CONFIG
# ===========================================
# Nível do log (debug, info, warn, error)
LOG_LEVEL=info

# Habilitar logging em arquivo
ENABLE_FILE_LOGGING=false

# Caminho do arquivo de log
LOG_FILE_PATH=./logs/app.log

# ===========================================
# RATE LIMITING
# ===========================================
# Janela de tempo para rate limiting (ms)
RATE_LIMIT_WINDOW=900000

# Máximo de requisições por janela
RATE_LIMIT_MAX=100

# ===========================================
# CACHE CONFIG
# ===========================================
# TTL do cache em segundos
CACHE_TTL=300

# Tamanho máximo do cache
CACHE_MAX_SIZE=100

# ===========================================
# EXEMPLOS DE CONFIG
# ===========================================
# Para desenvolvimento local:
# NODE_ENV=development
# PORT=3001
# WEBHOOK_URL=http://localhost:3001/api/webhooks/evolution

# Para produção Railway:
# NODE_ENV=production
# PORT=${PORT}
# WEBHOOK_URL=https://seu-app.railway.app/api/webhooks/evolution

# ===========================================
# IMPORTANTE
# ===========================================
# 1. NUNCA comitar .env no repositório
# 2. Manter EVOLUTION_API_KEY e SUPABASE_SERVICE_ROLE_KEY seguros
# 3. WEBHOOK_URL deve ser pública e acessível
# 4. Em produção, usar HTTPS no WEBHOOK_URL
